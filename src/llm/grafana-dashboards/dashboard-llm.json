      "title": "LLM Request Latency (Histogram)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "YOUR_PROM_UID"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(llm_request_latency_seconds_bucket[5m])) by (le))",
